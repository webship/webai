{
  "name": "drupal/webai",
  "description": "A picked collection of AI tools and providers, with more advanced artificial intelligence options. Part of Webship: the UI Suite UIkit theme (UIkit and HTMX) on top of Drupal and Display Builder.",
  "type": "drupal-module",
  "homepage": "https://www.drupal.org/project/webai",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Webship",
      "homepage": "https://webship.co",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://www.drupal.org/project/issues/webai",
    "source": "http://cgit.drupalcode.org/webai"
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  },
  "require": {
    "drupal/core": "^11.4 || ^12",
    "drupal/ai": "^1.4",
    "drupal/ai_agents": "^1.3",
    "drupal/ai_image_alt_text": "^1.0",
    "drupal/key": "^1.18",
    "drupal/ai_provider_anthropic": "^1.2",
    "drupal/ai_provider_openai": "^1.2",
    "drupal/gemini_provider": "^1.0",
    "drupal/ai_provider_xai": "^1.0@alpha",
    "drupal/ai_provider_huggingface": "^1.0@rc",
    "drupal/ai_provider_ollama": "^1.2@rc",
    "drupal/ai_provider_mistral": "^1.1@rc",
    "drupal/display_builder_ai": "^1.0@dev",
    "drupal/ai_penpot": "^1.0@alpha",
    "drupal/ai_playwright": "^1.0@alpha"
  }
